\set ON_ERROR_STOP on
\ir activity_report_evidence_integrity.psql
\ir ../migrations/0016_learning_events_source_ownership.sql

INSERT INTO learning.center_classes(center_id,class_id,title)
 VALUES ('a','11111111-1111-4111-8111-000000000001','Synthetic class A'),
        ('b','22222222-2222-4222-8222-000000000002','Synthetic class B');
INSERT INTO learning.class_sessions(center_id,session_id,class_id,session_title,scheduled_at)
 VALUES ('a','33333333-3333-4333-8333-000000000003','11111111-1111-4111-8111-000000000001',
          'Synthetic session A',NULL),
        ('b','44444444-4444-4444-8444-000000000004','22222222-2222-4222-8222-000000000002',
          'Synthetic session B',NULL);
INSERT INTO events.center_events(center_id,event_id,event_title,scheduled_at)
 VALUES ('a','55555555-5555-4555-8555-000000000005','Synthetic event A',NULL),
        ('b','66666666-6666-4666-8666-000000000006','Synthetic event B',NULL);

DO $test$
DECLARE
 p_center text:='a';
 p_link uuid:='99999999-9999-4999-8999-999999999999';
 p_draft uuid:='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
 p_session uuid:='33333333-3333-4333-8333-000000000003';
 p_event uuid:='55555555-5555-4555-8555-000000000005';
 p_session_report uuid:='77777777-7777-4777-8777-000000000007';
 p_event_report uuid:='88888888-8888-4888-8888-000000000008';
BEGIN
 PERFORM programs.record_center_sourced_activity_report(
   p_session_report,p_center,p_link,p_draft,'CLASS_SESSION',p_session,
   'synthetic-unverified-evidence-session','Submitted source session, not delivery',
   NULL,'fixture',gen_random_uuid(),gen_random_uuid(),'source-session');
 PERFORM programs.record_center_sourced_activity_report(
   p_event_report,p_center,p_link,p_draft,'CENTER_EVENT',p_event,
   'synthetic-unverified-evidence-event','Submitted source event, not delivery',
   NULL,'fixture',gen_random_uuid(),gen_random_uuid(),'source-event');

 IF (SELECT count(*) FROM programs.activity_report_source_bindings)<>2 OR
    (SELECT count(*) FROM programs.center_activity_reports)<>24 OR
    (SELECT count(*) FROM governance.command_audit
     WHERE action_code='UNVERIFIED_ACTIVITY_REPORT_RECORDED')<>24 OR
    (SELECT count(*) FROM governance.outbox_events
     WHERE event_type='UnverifiedActivityReportRecorded')<>24 THEN
  RAISE EXCEPTION 'Owner source report and audit/outbox cardinality mismatch';
 END IF;
 IF NOT EXISTS(SELECT 1 FROM programs.activity_report_source_bindings
   WHERE center_id='a' AND report_id=p_session_report AND
   class_session_id=p_session AND event_id IS NULL)
   OR NOT EXISTS(SELECT 1 FROM programs.activity_report_source_bindings
   WHERE center_id='a' AND report_id=p_event_report AND
   event_id=p_event AND class_session_id IS NULL) THEN
   RAISE EXCEPTION 'Wrong source-owner binding';
 END IF;
 IF EXISTS(SELECT 1 FROM learning.class_sessions WHERE scheduled_at IS NOT NULL)
   OR EXISTS(SELECT 1 FROM events.center_events WHERE scheduled_at IS NOT NULL) THEN
   RAISE EXCEPTION 'Missing schedule timestamp invented';
 END IF;

 -- The source exists but in the OTHER center; FK must be the point of failure.
 BEGIN
  PERFORM programs.record_center_sourced_activity_report(
    gen_random_uuid(),p_center,p_link,p_draft,'CLASS_SESSION',
    '44444444-4444-4444-8444-000000000004','cross-tenant-evidence',
    'Forbidden',NULL,'fixture',gen_random_uuid(),gen_random_uuid(),'cross-session');
  RAISE EXCEPTION 'Cross-center session accepted';
 EXCEPTION WHEN foreign_key_violation THEN NULL;
 END;
 BEGIN
  PERFORM programs.record_center_sourced_activity_report(
    gen_random_uuid(),p_center,p_link,p_draft,'CENTER_EVENT',
    '66666666-6666-4666-8666-000000000006','cross-tenant-event',
    'Forbidden',NULL,'fixture',gen_random_uuid(),gen_random_uuid(),'cross-event');
  RAISE EXCEPTION 'Cross-center event accepted';
 EXCEPTION WHEN foreign_key_violation THEN NULL;
 END;
 BEGIN
  PERFORM programs.record_center_sourced_activity_report(
    gen_random_uuid(),p_center,p_link,p_draft,'CLASS_SESSION',gen_random_uuid(),
    'unknown-source','Forbidden',NULL,'fixture',
    gen_random_uuid(),gen_random_uuid(),'missing');
  RAISE EXCEPTION 'Unknown session accepted';
 EXCEPTION WHEN foreign_key_violation THEN NULL;
 END;
 BEGIN
  PERFORM programs.record_center_sourced_activity_report(
    gen_random_uuid(),p_center,p_link,p_draft,'NOT_A_SOURCE',p_session,
    'unsupported-kind','Forbidden',NULL,'fixture',
    gen_random_uuid(),gen_random_uuid(),'unsupported');
  RAISE EXCEPTION 'Unknown source kind accepted';
 EXCEPTION WHEN invalid_parameter_value THEN NULL;
 END;
 BEGIN
  PERFORM programs.record_center_sourced_activity_report(
    gen_random_uuid(),p_center,p_link,p_draft,'CLASS_SESSION',p_session,
    'synthetic-unverified-evidence-session','Duplicate',NULL,'fixture',
    gen_random_uuid(),gen_random_uuid(),'duplicate');
  RAISE EXCEPTION 'Duplicate report source evidence accepted';
 EXCEPTION WHEN unique_violation THEN NULL;
 END;
 BEGIN
  PERFORM programs.record_center_sourced_activity_report(
    '99999999-9999-4999-8999-000000000009',p_center,p_link,p_draft,
    'CENTER_EVENT',p_event,'synthetic-audit-rollback','Atomic rollback',NULL,'fixture',
    '90000000-0000-4000-8000-000000000001',
    gen_random_uuid(),'rollback');
  RAISE EXCEPTION 'Audit collision accepted';
 EXCEPTION WHEN unique_violation THEN NULL;
 END;
 IF EXISTS (SELECT 1 FROM programs.center_activity_reports
   WHERE report_id='99999999-9999-4999-8999-000000000009')
   OR EXISTS (SELECT 1 FROM programs.activity_report_source_bindings
   WHERE report_id='99999999-9999-4999-8999-000000000009') THEN
   RAISE EXCEPTION 'Atomic rollback left partial source binding';
 END IF;

 BEGIN
  UPDATE learning.class_sessions SET session_title='Tampered';
  RAISE EXCEPTION 'Session mutation accepted';
 EXCEPTION WHEN check_violation THEN NULL;
 END;
 BEGIN
  DELETE FROM events.center_events;
  RAISE EXCEPTION 'Event deletion accepted';
 EXCEPTION WHEN check_violation THEN NULL;
 END;
 BEGIN
  UPDATE programs.activity_report_source_bindings SET event_id=NULL;
  RAISE EXCEPTION 'Report link mutation accepted';
 EXCEPTION WHEN check_violation THEN NULL;
 END;
 IF has_function_privilege('public',
   'programs.record_center_sourced_activity_report(uuid,text,uuid,uuid,text,uuid,text,text,timestamptz,text,uuid,uuid,text)',
   'EXECUTE') OR
   has_table_privilege('public','learning.class_sessions','INSERT') OR
   has_table_privilege('public','events.center_events','INSERT') THEN
  RAISE EXCEPTION 'Public gained unauthorized source write capability';
 END IF;
 IF (SELECT count(*) FROM programs.activity_report_source_bindings)<>2 OR
    (SELECT count(*) FROM programs.center_activity_reports)<>24 THEN
   RAISE EXCEPTION 'Rejected source operations mutated report history';
 END IF;
END;$test$;

DO $role$
BEGIN
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='kanoonyar_source_reader_ci') THEN
  CREATE ROLE kanoonyar_source_reader_ci NOLOGIN NOSUPERUSER NOBYPASSRLS;
 END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='kanoonyar_source_reader_ci'
   AND NOT rolcanlogin AND NOT rolsuper AND NOT rolbypassrls) THEN
  RAISE EXCEPTION 'Unsafe source fixture role';
 END IF;
END;$role$;
GRANT USAGE ON SCHEMA learning,events,programs TO kanoonyar_source_reader_ci;
GRANT SELECT ON learning.center_classes,learning.class_sessions,events.center_events,
 programs.activity_report_source_bindings TO kanoonyar_source_reader_ci;
SET ROLE kanoonyar_source_reader_ci;
SELECT set_config('kanoonyar.center_id','b',false);
DO $test$ BEGIN
 IF (SELECT count(*) FROM learning.class_sessions)<>1 OR
    (SELECT count(*) FROM events.center_events)<>1 OR
    EXISTS(SELECT 1 FROM programs.activity_report_source_bindings) THEN
  RAISE EXCEPTION 'Source center B leaked A source bindings';
 END IF;
END;$test$;
SELECT set_config('kanoonyar.center_id','a',false);
DO $test$ BEGIN
 IF (SELECT count(*) FROM learning.class_sessions)<>1 OR
    (SELECT count(*) FROM events.center_events)<>1 OR
    (SELECT count(*) FROM programs.activity_report_source_bindings)<>2 THEN
  RAISE EXCEPTION 'Source center A RLS boundary wrong';
 END IF;
END;$test$;
RESET ROLE;
