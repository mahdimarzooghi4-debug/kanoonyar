\set ON_ERROR_STOP on
\ir ../migrations/0001_national_program_foundation.sql
\ir ../migrations/0002_append_only_national_versions.sql
\ir ../migrations/0003_center_registry.sql
\ir ../migrations/0004_command_audit.sql
\ir ../migrations/0005_transactional_outbox.sql
\ir ../migrations/0006_center_scope_rls.sql
\ir ../migrations/0007_atomic_local_plan_command.sql
\ir ../migrations/0008_center_membership_read_boundary.sql
\ir ../migrations/0009_center_membership_db_session_boundary.sql
\ir ../migrations/0010_local_plan_revision_foundation.sql
\ir ../migrations/0022_center_site_page_drafts.sql
INSERT INTO centers.registry(center_id,display_name,is_active,registered_by_subject,registered_at)
 VALUES('a','A',true,'fixture',now()),('b','B',true,'fixture',now());
INSERT INTO centers.memberships(center_id,subject_id,role_code,is_active,recorded_by_subject,recorded_at)
 VALUES('a','actor-a','fixture',true,'fixture',now()),('b','actor-b','fixture',true,'fixture',now());
CREATE ROLE kanoonyar_s20_sql_test NOLOGIN NOSUPERUSER NOBYPASSRLS NOCREATEDB NOCREATEROLE NOREPLICATION;
GRANT USAGE ON SCHEMA web TO kanoonyar_s20_sql_test;
GRANT EXECUTE ON FUNCTION web.append_center_page_draft(text,uuid,bigint,text,text,text,text,uuid,uuid,text)
 TO kanoonyar_s20_sql_test;
SET ROLE kanoonyar_s20_sql_test;
SELECT set_config('kanoonyar.center_id','a',false);
DO $verify$ DECLARE p uuid:='88888888-0000-4000-8000-000000000001';v bigint;
BEGIN
 SELECT web.append_center_page_draft('a',p,0,'center-home','Home','Text v1','actor-a',
  gen_random_uuid(),gen_random_uuid(),'web-1') INTO v;
 IF v<>1 THEN RAISE EXCEPTION 'Initial page revision wrong'; END IF;
 SELECT web.append_center_page_draft('a',p,1,'center-home','Home 2','Text v2','actor-a',
  gen_random_uuid(),gen_random_uuid(),'web-2') INTO v;
 IF v<>2 THEN RAISE EXCEPTION 'Second page revision wrong'; END IF;
 BEGIN
  PERFORM web.append_center_page_draft('a',p,1,'center-home','Stale','stale','actor-a',
   gen_random_uuid(),gen_random_uuid(),'stale');
  RAISE EXCEPTION 'Stale accepted';
 EXCEPTION WHEN serialization_failure THEN NULL; END;
 BEGIN
  PERFORM web.append_center_page_draft('a',p,2,'changed-slug','Bad','body','actor-a',
   gen_random_uuid(),gen_random_uuid(),'slug');
  RAISE EXCEPTION 'Slug alteration accepted';
 EXCEPTION WHEN foreign_key_violation THEN NULL; END;
 BEGIN
  PERFORM web.append_center_page_draft('a',gen_random_uuid(),0,'center-home','Conflict','Text','actor-a',
   gen_random_uuid(),gen_random_uuid(),'duplicate');
  RAISE EXCEPTION 'Duplicate slug accepted';
 EXCEPTION WHEN unique_violation THEN NULL; END;
 BEGIN
  PERFORM web.append_center_page_draft('a',gen_random_uuid(),0,'private','Bad','body','actor-b',
   gen_random_uuid(),gen_random_uuid(),'cross');
  RAISE EXCEPTION 'Foreign actor accepted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM web.append_center_page_draft('a',gen_random_uuid(),0,'INVALID/URL','Bad','body','actor-a',
   gen_random_uuid(),gen_random_uuid(),'invalid');
  RAISE EXCEPTION 'Unsafe slug accepted';
 EXCEPTION WHEN invalid_parameter_value THEN NULL; END;
END;$verify$;
RESET ROLE;
DO $verify$ BEGIN
 IF (SELECT count(*) FROM web.center_pages)<>1
  OR (SELECT count(*) FROM web.page_draft_revisions)<>2
  OR (SELECT count(*) FROM governance.command_audit WHERE action_code='CENTER_SITE_DRAFT_REVISION_APPENDED')<>2
  OR (SELECT count(*) FROM governance.outbox_events WHERE event_type='CenterSiteDraftRevisionAppended')<>2
  OR has_table_privilege('kanoonyar_s20_sql_test','web.page_draft_revisions','INSERT')
  OR has_function_privilege('public',
    'web.append_center_page_draft(text,uuid,bigint,text,text,text,text,uuid,uuid,text)','EXECUTE')
 THEN RAISE EXCEPTION 'Draft atomicity or privilege failure'; END IF;
END;$verify$;
CREATE ROLE kanoonyar_s20_reader NOLOGIN NOSUPERUSER NOBYPASSRLS NOCREATEDB NOCREATEROLE NOREPLICATION;
GRANT USAGE ON SCHEMA web TO kanoonyar_s20_reader;
GRANT SELECT ON web.center_pages,web.page_draft_revisions TO kanoonyar_s20_reader;
SET ROLE kanoonyar_s20_reader;
SELECT set_config('kanoonyar.center_id','b',false);
DO $isolated$ BEGIN
 IF EXISTS(SELECT 1 FROM web.center_pages)
  OR EXISTS(SELECT 1 FROM web.page_draft_revisions)
 THEN RAISE EXCEPTION 'Cross-center private draft leaked'; END IF;
END;$isolated$;
SELECT set_config('kanoonyar.center_id','a',false);
DO $own$ BEGIN
 IF (SELECT count(*) FROM web.page_draft_revisions)<>2
 THEN RAISE EXCEPTION 'Own-center drafts hidden'; END IF;
END;$own$;
RESET ROLE;
DO $immut$ BEGIN
 BEGIN
  UPDATE web.page_draft_revisions SET title='tampered';
  RAISE EXCEPTION 'Immutable draft modified';
 EXCEPTION WHEN check_violation THEN NULL; END;
END;$immut$;
