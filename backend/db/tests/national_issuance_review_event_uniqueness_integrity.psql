-- S63: duplicate append-only event envelopes fail closed while unrelated
-- event types remain outside these narrowly scoped unique constraints.
\set ON_ERROR_STOP on

DO $indexes$
BEGIN
 IF (SELECT count(*) FROM pg_indexes
     WHERE schemaname='governance' AND indexname IN (
       'national_issuance_review_audit_target_uq',
       'national_issuance_review_outbox_aggregate_uq',
       'national_issuance_review_outbox_audit_uq'
     ) AND indexdef ILIKE 'CREATE UNIQUE INDEX%')<>3
 THEN RAISE EXCEPTION 'S63 scoped unique indexes are missing'; END IF;
END;$indexes$;

DO $dedupe$
DECLARE
 audit_before bigint;
 outbox_before bigint;
BEGIN
 SELECT count(*) INTO audit_before FROM governance.command_audit;
 SELECT count(*) INTO outbox_before FROM governance.outbox_events;

 -- Same S60 intent and same S61 inspection target cannot gain a second
 -- audit row under a new audit UUID.
 BEGIN
   INSERT INTO governance.command_audit
    (audit_id,occurred_at,actor_subject_id,center_id,action_code,
     target_type,target_id,correlation_id,metadata)
   SELECT gen_random_uuid(),occurred_at,actor_subject_id,center_id,action_code,
     target_type,target_id,'s63-duplicate-s60',metadata
   FROM governance.command_audit
   WHERE audit_id='aa600000-0000-4000-8000-000000000002';
   RAISE EXCEPTION 'Duplicate S60 request audit was accepted';
 EXCEPTION WHEN unique_violation THEN NULL; END;

 BEGIN
   INSERT INTO governance.command_audit
    (audit_id,occurred_at,actor_subject_id,center_id,action_code,
     target_type,target_id,correlation_id,metadata)
   SELECT gen_random_uuid(),occurred_at,actor_subject_id,center_id,action_code,
     target_type,target_id,'s63-duplicate-s61',metadata
   FROM governance.command_audit
   WHERE audit_id='aa610000-0000-4000-8000-000000000022';
   RAISE EXCEPTION 'Duplicate S61 inspection audit was accepted';
 EXCEPTION WHEN unique_violation THEN NULL; END;

 -- Duplicate event/aggregate envelopes fail even if they use another
 -- event UUID. The audit UUID also cannot back a second review outbox row.
 BEGIN
   INSERT INTO governance.outbox_events
    (event_id,audit_id,event_type,aggregate_type,aggregate_id,occurred_at,payload)
   SELECT gen_random_uuid(),audit_id,event_type,aggregate_type,aggregate_id,
     occurred_at,payload
   FROM governance.outbox_events
   WHERE event_id='aa600000-0000-4000-8000-000000000003';
   RAISE EXCEPTION 'Duplicate S60 request outbox event was accepted';
 EXCEPTION WHEN unique_violation THEN NULL; END;

 BEGIN
   INSERT INTO governance.outbox_events
    (event_id,audit_id,event_type,aggregate_type,aggregate_id,occurred_at,payload)
   SELECT gen_random_uuid(),audit_id,event_type,aggregate_type,aggregate_id,
     occurred_at,payload
   FROM governance.outbox_events
   WHERE event_id='aa610000-0000-4000-8000-000000000023';
   RAISE EXCEPTION 'Duplicate S61 inspection outbox event was accepted';
 EXCEPTION WHEN unique_violation THEN NULL; END;

 BEGIN
   INSERT INTO governance.outbox_events
    (event_id,audit_id,event_type,aggregate_type,aggregate_id,occurred_at,payload)
   SELECT gen_random_uuid(),audit_id,event_type,aggregate_type,
     's63-distinct-aggregate',occurred_at,payload
   FROM governance.outbox_events
   WHERE event_id='aa610000-0000-4000-8000-000000000023';
   RAISE EXCEPTION 'Review audit was reused for a second outbox event';
 EXCEPTION WHEN unique_violation THEN NULL; END;

 IF (SELECT count(*) FROM governance.command_audit)<>audit_before
 OR (SELECT count(*) FROM governance.outbox_events)<>outbox_before
 THEN RAISE EXCEPTION 'Rejected duplicate left partial event rows'; END IF;
END;$dedupe$;
\ir national_issuance_review_event_atomicity_integrity.psql
