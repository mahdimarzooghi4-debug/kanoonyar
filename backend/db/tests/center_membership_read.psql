\set ON_ERROR_STOP on
\ir ../migrations/0001_national_program_foundation.sql
\ir ../migrations/0002_append_only_national_versions.sql
\ir ../migrations/0003_center_registry.sql
\ir ../migrations/0004_command_audit.sql
\ir ../migrations/0005_transactional_outbox.sql
\ir ../migrations/0006_center_scope_rls.sql
\ir ../migrations/0007_atomic_local_plan_command.sql
\ir ../migrations/0008_center_membership_read_boundary.sql
INSERT INTO centers.registry(center_id,display_name,is_active,registered_by_subject,registered_at)
VALUES ('center-a','Active Center',true,'admin',now()),('center-b','Inactive Center',false,'admin',now());
INSERT INTO centers.memberships(center_id,subject_id,role_code,is_active,recorded_by_subject,recorded_at)
VALUES ('center-a','subject-a','role-1',true,'admin',now()),
('center-a','subject-b','role-2',true,'admin',now()),
('center-a','subject-a','revoked',false,'admin',now()),
('center-b','subject-a','role-3',true,'admin',now());
DO $$ BEGIN
 IF (SELECT count(*) FROM centers.list_active_memberships_for_subject('subject-a')) <> 1 THEN
    RAISE EXCEPTION 'Subject-scoped active membership read failed'; END IF;
 IF (SELECT count(*) FROM centers.list_active_memberships_for_subject('subject-b')) <> 1 THEN
    RAISE EXCEPTION 'Other subject membership read failed'; END IF;
 IF EXISTS (SELECT 1 FROM centers.list_active_memberships_for_subject(NULL)) THEN
    RAISE EXCEPTION 'Null subject must yield no memberships'; END IF;
 IF EXISTS (SELECT 1 FROM centers.list_active_memberships_for_subject('subject-c')) THEN
    RAISE EXCEPTION 'Unknown subject must yield no memberships'; END IF;
END $$;
DO $$ BEGIN
 IF has_function_privilege('public', 'centers.list_active_memberships_for_subject(text)', 'EXECUTE') THEN
    RAISE EXCEPTION 'PUBLIC execute must be revoked'; END IF;
END $$;
