\set ON_ERROR_STOP on
\ir ../migrations/0001_national_program_foundation.sql
\ir ../migrations/0002_append_only_national_versions.sql
\ir ../migrations/0003_center_registry.sql
\ir ../migrations/0004_command_audit.sql
\ir ../migrations/0005_transactional_outbox.sql
\ir ../migrations/0006_center_scope_rls.sql
\ir ../migrations/0007_atomic_local_plan_command.sql
\ir ../migrations/0008_center_membership_read_boundary.sql
\ir ../migrations/0009_center_membership_db_session_boundary.sql
\ir ../migrations/0010_local_plan_revision_foundation.sql
\ir ../migrations/0011_local_plan_atomic_revision_command.sql
DO $test$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_policies WHERE schemaname='programs' AND tablename='center_plan_draft_revisions' AND policyname='center_plan_draft_scope') THEN
    RAISE EXCEPTION 'Center draft RLS policy missing';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname='draft_revision_immutable' AND NOT tgisinternal) THEN
    RAISE EXCEPTION 'Immutable revision trigger missing';
  END IF;
  IF has_function_privilege('public', 'programs.append_local_plan_draft_revision(text,uuid,bigint,text,integer,text,jsonb,text,uuid,uuid,text)', 'EXECUTE') THEN
    RAISE EXCEPTION 'PUBLIC must not execute draft command';
  END IF;
  IF has_table_privilege('public', 'programs.center_plan_draft_revisions', 'INSERT') THEN
    RAISE EXCEPTION 'PUBLIC must not insert drafts';
  END IF;
END;
$test$;

-- Exercise the actual command, not only metadata. Disposable CI database only.
INSERT INTO centers.registry(center_id,display_name,is_active,registered_by_subject,registered_at)
VALUES ('center-a','Center A',true,'admin',now()),('center-b','Center B',true,'admin',now());
INSERT INTO programs.national_program_versions
(program_id,version,title,national_objectives,mandatory_requirements,created_by_subject,created_at)
VALUES ('national-1',1,'National 1','[]','[]','hq',now());
INSERT INTO programs.national_program_publications
(program_id,version,publisher_subject,published_at)
VALUES ('national-1',1,'hq',now());
SELECT set_config('kanoonyar.center_id','center-a',false);
DO $test$
DECLARE
  v_draft uuid := '11111111-1111-4111-8111-111111111111';
  v_revision bigint;
BEGIN
  SELECT programs.append_local_plan_draft_revision('center-a',v_draft,0,
    'national-1',1,'First draft','["Activity 1"]'::jsonb,'actor',
    '11111111-1111-4111-8111-111111111112',
    '11111111-1111-4111-8111-111111111113','correlation-1') INTO v_revision;
  IF v_revision <> 1 THEN RAISE EXCEPTION 'Expected revision 1'; END IF;
  SELECT programs.append_local_plan_draft_revision('center-a',v_draft,1,
    'national-1',1,'Updated draft','["Activity 2"]'::jsonb,'actor',
    '11111111-1111-4111-8111-111111111114',
    '11111111-1111-4111-8111-111111111115','correlation-2') INTO v_revision;
  IF v_revision <> 2 THEN RAISE EXCEPTION 'Expected revision 2'; END IF;
  IF (SELECT count(*) FROM governance.command_audit WHERE target_id=v_draft::text) <> 2
    OR (SELECT count(*) FROM governance.outbox_events WHERE aggregate_id=v_draft::text) <> 2 THEN
    RAISE EXCEPTION 'Audit and outbox must match accepted revisions';
  END IF;
  BEGIN
    PERFORM programs.append_local_plan_draft_revision('center-a',v_draft,1,
      'national-1',1,'Stale','[]'::jsonb,'actor',
      '11111111-1111-4111-8111-111111111116',
      '11111111-1111-4111-8111-111111111117','correlation-3');
    RAISE EXCEPTION 'Expected stale revision rejection';
  EXCEPTION WHEN SQLSTATE '40001' THEN NULL;
  END;
  BEGIN
    UPDATE programs.center_plan_draft_revisions SET local_title='tampered'
    WHERE center_id='center-a' AND draft_id=v_draft;
    RAISE EXCEPTION 'Expected immutable history rejection';
  EXCEPTION WHEN SQLSTATE '23514' THEN NULL;
  END;
  IF (SELECT count(*) FROM programs.center_plan_draft_revisions WHERE draft_id=v_draft) <> 2 THEN
    RAISE EXCEPTION 'Failed commands must not create revisions';
  END IF;
END;
$test$;
SELECT set_config('kanoonyar.center_id','center-b',false);
DO $test$
BEGIN
  IF EXISTS (SELECT 1 FROM programs.center_plan_draft_revisions WHERE center_id='center-a') THEN
    RAISE EXCEPTION 'Cross-center draft leak';
  END IF;
END;
$test$;
