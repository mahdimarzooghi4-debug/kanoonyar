\set ON_ERROR_STOP on
\ir ../migrations/0001_national_program_foundation.sql
\ir ../migrations/0002_append_only_national_versions.sql
\ir ../migrations/0003_center_registry.sql
\ir ../migrations/0004_command_audit.sql
\ir ../migrations/0005_transactional_outbox.sql
\ir ../migrations/0006_center_scope_rls.sql
\ir ../migrations/0007_atomic_local_plan_command.sql
\ir ../migrations/0008_center_membership_read_boundary.sql
\ir ../migrations/0009_center_membership_db_session_boundary.sql
\ir ../migrations/0010_local_plan_revision_foundation.sql
\ir ../migrations/0011_local_plan_atomic_revision_command.sql
\ir ../migrations/0012_restricted_draft_command_owner.sql
\ir ../migrations/0013_national_program_issuance_foundation.sql
\ir ../migrations/0014_national_to_local_plan_trace.sql
INSERT INTO centers.registry(center_id,display_name,is_active,registered_by_subject,registered_at)
VALUES('a','Center A',true,'fixture',now()),('b','Center B',true,'fixture',now());
INSERT INTO centers.memberships(center_id,subject_id,role_code,is_active,recorded_by_subject,recorded_at)
VALUES('a','actor-a','fixture',true,'fixture',now());
INSERT INTO programs.national_program_versions(program_id,version,title,national_objectives,mandatory_requirements,created_by_subject,created_at)
VALUES('n',1,'National 1','[]','[]','fixture',now()),('n',2,'National 2','[]','[]','fixture',now());
INSERT INTO programs.national_program_publications(program_id,version,publisher_subject,published_at)
VALUES('n',1,'fixture',now()),('n',2,'fixture',now());
INSERT INTO programs.national_program_issuances(issuance_id,center_id,program_id,national_version,issued_by_subject,issued_at)
VALUES('11111111-1111-4111-8111-111111111111','a','n',1,'fixture',now()),
('22222222-2222-4222-8222-222222222222','b','n',1,'fixture',now()),
('33333333-3333-4333-8333-333333333333','a','n',2,'fixture',now());
SELECT set_config('kanoonyar.center_id','a',false);
SELECT programs.append_local_plan_draft_revision('a',
 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa',0,'n',1,'First','["Workshop"]',
 'actor-a','a1111111-1111-4111-8111-111111111111',
 'a2222222-2222-4222-8222-222222222222','rev1');
SELECT programs.append_local_plan_draft_revision('a',
 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa',1,'n',1,'Second','["Workshop","Class"]',
 'actor-a','a3333333-3333-4333-8333-333333333333',
 'a4444444-4444-4444-8444-444444444444','rev2');
DO $test$
DECLARE link_id uuid:='99999999-9999-4999-8999-999999999999';
 draft uuid:='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
BEGIN
 PERFORM programs.record_center_plan_issuance_link(link_id,'a',draft,1,
  '11111111-1111-4111-8111-111111111111','n',1,'actor-a',
  '90000000-0000-4000-8000-000000000001',
  '90000000-0000-4000-8000-000000000002','trace1');
 IF (SELECT pinned_revision FROM programs.center_plan_issuance_links
     WHERE link_id=link_id)<>1 THEN RAISE EXCEPTION 'Wrong pinned revision'; END IF;
 IF (SELECT count(*) FROM governance.command_audit WHERE target_id=link_id::text)<>1 OR
    (SELECT count(*) FROM governance.outbox_events WHERE aggregate_id=link_id::text)<>1 THEN
  RAISE EXCEPTION 'Audit/outbox cardinality'; END IF;
 BEGIN
  PERFORM programs.record_center_plan_issuance_link(
    '90000000-0000-4000-8000-000000000003','a',draft,2,
    '11111111-1111-4111-8111-111111111111','n',1,'actor-a',
    '90000000-0000-4000-8000-000000000004',
    '90000000-0000-4000-8000-000000000005','duplicate');
  RAISE EXCEPTION 'Rebind accepted';
 EXCEPTION WHEN unique_violation THEN NULL; END;
 BEGIN
  PERFORM programs.record_center_plan_issuance_link(
    '90000000-0000-4000-8000-000000000006','a',draft,2,
    '22222222-2222-4222-8222-222222222222','n',1,'actor-a',
    '90000000-0000-4000-8000-000000000007',
    '90000000-0000-4000-8000-000000000008','cross-center');
  RAISE EXCEPTION 'Cross center accepted';
 EXCEPTION WHEN foreign_key_violation THEN NULL; WHEN unique_violation THEN NULL; END;
 BEGIN
  PERFORM programs.record_center_plan_issuance_link(
    '90000000-0000-4000-8000-000000000009','a',draft,2,
    '33333333-3333-4333-8333-333333333333','n',2,'actor-a',
    '90000000-0000-4000-8000-000000000010',
    '90000000-0000-4000-8000-000000000011','mismatch');
  RAISE EXCEPTION 'Wrong national version accepted';
 EXCEPTION WHEN foreign_key_violation THEN NULL; WHEN unique_violation THEN NULL; END;
 BEGIN
  UPDATE programs.center_plan_issuance_links SET pinned_revision=2
  WHERE link_id=link_id;
  RAISE EXCEPTION 'Immutable UPDATE passed';
 EXCEPTION WHEN check_violation THEN NULL; END;
 BEGIN
  DELETE FROM programs.center_plan_issuance_links WHERE link_id=link_id;
  RAISE EXCEPTION 'Immutable DELETE passed';
 EXCEPTION WHEN check_violation THEN NULL; END;
 IF (SELECT count(*) FROM programs.center_plan_issuance_links)<>1 OR
    (SELECT count(*) FROM governance.outbox_events
      WHERE event_type='CenterPlanIssuanceLinkRecorded')<>1 THEN
   RAISE EXCEPTION 'Failed records left partial changes'; END IF;
 IF has_function_privilege('public',
 'programs.record_center_plan_issuance_link(uuid,text,uuid,bigint,uuid,text,integer,text,uuid,uuid,text)','EXECUTE') THEN
   RAISE EXCEPTION 'PUBLIC can create links'; END IF;
END;$test$;
CREATE ROLE kanoonyar_trace_reader_ci NOLOGIN NOSUPERUSER NOBYPASSRLS;
GRANT USAGE ON SCHEMA programs TO kanoonyar_trace_reader_ci;
GRANT SELECT ON programs.center_plan_issuance_links TO kanoonyar_trace_reader_ci;
SET ROLE kanoonyar_trace_reader_ci;
SELECT set_config('kanoonyar.center_id','b',false);
DO $test$ BEGIN
 IF EXISTS(SELECT 1 FROM programs.center_plan_issuance_links) THEN
  RAISE EXCEPTION 'Cross center RLS leak'; END IF;
END;$test$;
SELECT set_config('kanoonyar.center_id','a',false);
DO $test$ BEGIN
 IF (SELECT count(*) FROM programs.center_plan_issuance_links)<>1 THEN
  RAISE EXCEPTION 'Own scope RLS missed'; END IF;
END;$test$;
RESET ROLE;
