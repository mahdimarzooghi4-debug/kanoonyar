CREATE ROLE kanoonyar_draft_api_ci LOGIN NOSUPERUSER NOBYPASSRLS
 NOCREATEDB NOCREATEROLE NOREPLICATION;
GRANT CONNECT ON DATABASE kanoonyar_draft_api_ci TO kanoonyar_draft_api_ci;
GRANT USAGE ON SCHEMA programs,centers TO kanoonyar_draft_api_ci;
GRANT SELECT ON centers.memberships,centers.registry TO kanoonyar_draft_api_ci;

GRANT EXECUTE ON FUNCTION programs.append_local_plan_draft_revision(
  text,uuid,bigint,text,integer,text,jsonb,text,uuid,uuid,text) TO kanoonyar_draft_api_ci;

-- The CI role can be used only with a synthetic test evaluator. The production
-- evaluator for both read and write is always DENY. Direct DB privileges plus a
-- spoofable center_id GUC are not an approved security architecture.
DO $test$
BEGIN
  IF (SELECT rolsuper OR rolbypassrls OR rolcreaterole OR rolcreatedb
      FROM pg_roles WHERE rolname='kanoonyar_draft_api_ci') THEN
    RAISE EXCEPTION 'Integration role may not have elevated privileges';
  END IF;
  IF has_table_privilege('kanoonyar_draft_api_ci','programs.center_plan_draft_revisions','INSERT')
     OR has_table_privilege('kanoonyar_draft_api_ci','governance.command_audit','INSERT')
     OR has_table_privilege('kanoonyar_draft_api_ci','governance.outbox_events','INSERT') THEN
    RAISE EXCEPTION 'SQL command caller must not be able to bypass audit/outbox';
  END IF;
  IF has_function_privilege('public', 'programs.append_local_plan_draft_revision(
    text,uuid,bigint,text,integer,text,jsonb,text,uuid,uuid,text)', 'EXECUTE') THEN
    RAISE EXCEPTION 'PUBLIC function execution must remain revoked';
  END IF;
END;
$test$;


-- Independent least-privilege reader. The existing CI-only writer is intentionally
-- NOT inherited or reachable through SET ROLE. Never mirror these as Production grants.
CREATE ROLE kanoonyar_draft_read_ci LOGIN NOSUPERUSER NOBYPASSRLS
 NOCREATEDB NOCREATEROLE NOREPLICATION;
GRANT CONNECT ON DATABASE kanoonyar_draft_api_ci TO kanoonyar_draft_read_ci;
GRANT USAGE ON SCHEMA programs,centers,learning,events TO kanoonyar_draft_read_ci;
GRANT SELECT ON centers.memberships,centers.registry TO kanoonyar_draft_read_ci;
GRANT SELECT ON programs.center_plan_draft_revisions,programs.center_plan_issuance_links,
  programs.center_activity_reports,programs.activity_report_source_bindings TO kanoonyar_draft_read_ci;
GRANT SELECT ON learning.center_classes,learning.class_sessions,events.center_events TO kanoonyar_draft_read_ci;
GRANT SELECT ON learning.session_occurrence_reports,learning.session_attendance_claims TO kanoonyar_draft_read_ci;
GRANT SELECT ON learning.class_capacity_revisions,learning.class_registration_intents TO kanoonyar_draft_read_ci;
GRANT SELECT ON learning.registration_review_requests TO kanoonyar_draft_read_ci;
GRANT USAGE ON SCHEMA web TO kanoonyar_draft_read_ci;
GRANT SELECT ON web.center_pages,web.page_draft_revisions TO kanoonyar_draft_read_ci;
GRANT SELECT ON web.center_site_design_revisions TO kanoonyar_draft_read_ci;
GRANT SELECT ON web.center_forms,web.center_form_draft_revisions TO kanoonyar_draft_read_ci;
GRANT USAGE ON SCHEMA campaigns TO kanoonyar_draft_read_ci;
GRANT SELECT ON campaigns.center_campaigns,campaigns.center_campaign_revisions TO kanoonyar_draft_read_ci;
GRANT SELECT ON campaigns.campaign_report_links TO kanoonyar_draft_read_ci;
GRANT SELECT ON campaigns.campaign_report_inspection_notes TO kanoonyar_draft_read_ci;
DO $test$
BEGIN
  IF has_table_privilege('kanoonyar_draft_read_ci',
       'programs.center_plan_draft_revisions', 'INSERT') OR
     has_table_privilege('kanoonyar_draft_read_ci',
       'governance.command_audit', 'INSERT') OR
     has_table_privilege('kanoonyar_draft_read_ci',
       'governance.outbox_events', 'INSERT') OR
     has_function_privilege('kanoonyar_draft_read_ci',
       'programs.append_local_plan_draft_revision(text,uuid,bigint,text,integer,text,jsonb,text,uuid,uuid,text)',
       'EXECUTE') OR
     pg_has_role('kanoonyar_draft_read_ci','kanoonyar_draft_api_ci','SET') OR
     pg_has_role('kanoonyar_draft_read_ci','kanoonyar_draft_api_ci','MEMBER') THEN
    RAISE EXCEPTION 'Reader role must not inherit or acquire write privileges';
  END IF;
END;
$test$;


-- Separate escalation fixture: current privileges are read-only, but SET ROLE
-- would reach the command-executing writer. An API read connection must refuse this login.
CREATE ROLE kanoonyar_draft_escalation_ci LOGIN NOINHERIT NOSUPERUSER NOBYPASSRLS
 NOCREATEDB NOCREATEROLE NOREPLICATION;
GRANT CONNECT ON DATABASE kanoonyar_draft_api_ci TO kanoonyar_draft_escalation_ci;
GRANT USAGE ON SCHEMA programs,centers TO kanoonyar_draft_escalation_ci;
GRANT SELECT ON centers.memberships,centers.registry TO kanoonyar_draft_escalation_ci;
GRANT SELECT ON programs.center_plan_draft_revisions TO kanoonyar_draft_escalation_ci;
GRANT kanoonyar_draft_api_ci TO kanoonyar_draft_escalation_ci
  WITH INHERIT FALSE, SET TRUE;
DO $test$
BEGIN
 IF NOT pg_has_role('kanoonyar_draft_escalation_ci',
        'kanoonyar_draft_api_ci','SET') OR
    has_function_privilege('kanoonyar_draft_escalation_ci',
        'programs.append_local_plan_draft_revision(text,uuid,bigint,text,integer,text,jsonb,text,uuid,uuid,text)','EXECUTE') THEN
   RAISE EXCEPTION 'Escalation test role must require SET ROLE';
 END IF;
END;
$test$;


-- Disposable integration-only command LOGIN; NEVER use in Production.
CREATE ROLE kanoonyar_learning_api_ci LOGIN NOSUPERUSER NOBYPASSRLS
 NOCREATEDB NOCREATEROLE NOREPLICATION;
GRANT CONNECT ON DATABASE kanoonyar_draft_api_ci TO kanoonyar_learning_api_ci;
-- Schema-only name resolution for catalog safety checks; NOT data access.
GRANT USAGE ON SCHEMA learning,centers,programs TO kanoonyar_learning_api_ci;
GRANT SELECT ON centers.memberships,centers.registry TO kanoonyar_learning_api_ci;
GRANT EXECUTE ON FUNCTION learning.record_class_plan(text,uuid,text,text,uuid,uuid,text)
 TO kanoonyar_learning_api_ci;
GRANT EXECUTE ON FUNCTION learning.record_class_session_plan(
 text,uuid,uuid,text,timestamptz,text,uuid,uuid,text) TO kanoonyar_learning_api_ci;
DO $guard$
BEGIN
 IF has_table_privilege('kanoonyar_learning_api_ci','learning.center_classes','INSERT')
   OR has_table_privilege('kanoonyar_learning_api_ci','learning.class_sessions','INSERT')
   OR has_table_privilege('kanoonyar_learning_api_ci','governance.command_audit','INSERT')
   OR has_table_privilege('kanoonyar_learning_api_ci','governance.outbox_events','INSERT')
   OR pg_has_role('kanoonyar_learning_api_ci',
       'kanoonyar_learning_command_owner','SET') THEN
   RAISE EXCEPTION 'Test learning login can bypass auditing';
 END IF;
 IF has_function_privilege('kanoonyar_draft_read_ci',
  'learning.record_class_plan(text,uuid,text,text,uuid,uuid,text)','EXECUTE') THEN
   RAISE EXCEPTION 'Readonly SQL credential can execute learning commands';
 END IF;
END;$guard$;


-- Enforce a real restricted-login smoke, not a superuser-only migration proof.
-- The holder of this CI credential must be able to execute precisely the
-- audited class command while still lacking direct INSERT / SET ROLE.
SET ROLE kanoonyar_learning_api_ci;
SELECT set_config('kanoonyar.center_id','center-a',false);
DO $smoke$
BEGIN
 IF NOT EXISTS(
   SELECT 1 FROM centers.memberships m
   JOIN centers.registry c ON c.center_id=m.center_id
   WHERE m.center_id='center-a' AND m.subject_id='actor-a'
     AND m.is_active AND c.is_active
 ) THEN
  RAISE EXCEPTION 'Restricted learning login cannot see active own-center member';
 END IF;
 PERFORM learning.record_class_plan(
  'center-a','aabbccdd-1000-4000-8000-000000000001',
  'Restricted SQL fixture class','actor-a',
  'aabbccdd-1000-4000-8000-000000000002',
  'aabbccdd-1000-4000-8000-000000000003',
  'restricted-fixture');
END;$smoke$;
RESET ROLE;


