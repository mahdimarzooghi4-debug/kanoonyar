\set ON_ERROR_STOP on
-- Execute against disposable PostgreSQL only. CI creates and destroys this database.
\ir ../migrations/0001_national_program_foundation.sql
\ir ../migrations/0002_append_only_national_versions.sql

DO $test$
BEGIN
    INSERT INTO programs.national_program_versions
      (program_id, version, title, national_objectives, mandatory_requirements, created_by_subject, created_at)
    VALUES ('program-a', 1, 'National', '["objective"]', '["requirement"]', 'hq-actor', now());
    INSERT INTO programs.national_program_versions
      (program_id, version, title, national_objectives, mandatory_requirements, created_by_subject, created_at)
    VALUES ('program-a', 2, 'National v2', '["objective"]', '[]', 'hq-actor', now());

    BEGIN
        INSERT INTO programs.national_program_versions
          (program_id, version, title, national_objectives, mandatory_requirements, created_by_subject, created_at)
        VALUES ('program-a', 1, 'Duplicate', '[]', '[]', 'hq-actor', now());
        RAISE EXCEPTION 'duplicate national version was accepted';
    EXCEPTION WHEN unique_violation THEN NULL;
    END;

    BEGIN
        INSERT INTO programs.national_program_publications
          (program_id, version, publisher_subject, published_at)
        VALUES ('unknown', 1, 'hq-actor', now());
        RAISE EXCEPTION 'unknown national version was published';
    EXCEPTION WHEN foreign_key_violation THEN NULL;
    END;

    INSERT INTO programs.national_program_publications
      (program_id, version, publisher_subject, published_at)
    VALUES ('program-a', 1, 'hq-actor', now());

    BEGIN
        INSERT INTO programs.center_program_plans
          (center_id, plan_id, program_id, national_version, local_title, local_activities, created_by_subject, created_at)
        VALUES ('center-a', '00000000-0000-0000-0000-000000000002', 'program-a', 2, 'Local', '[]', 'center-actor', now());
        RAISE EXCEPTION 'unpublished national version was adopted';
    EXCEPTION WHEN foreign_key_violation THEN NULL;
    END;

    INSERT INTO programs.center_program_plans
      (center_id, plan_id, program_id, national_version, local_title, local_activities, created_by_subject, created_at)
    VALUES ('center-a', '00000000-0000-0000-0000-000000000001', 'program-a', 1, 'Local', '[]', 'center-actor', now());

    BEGIN
        UPDATE programs.national_program_versions SET title = 'Tampered'
        WHERE program_id = 'program-a' AND version = 1;
        RAISE EXCEPTION 'national version mutation was accepted';
    EXCEPTION WHEN check_violation THEN NULL;
    END;

    BEGIN
        DELETE FROM programs.national_program_publications
        WHERE program_id = 'program-a' AND version = 1;
        RAISE EXCEPTION 'publication deletion was accepted';
    EXCEPTION WHEN check_violation THEN NULL;
    END;

    IF (SELECT count(*) FROM programs.center_program_plans) <> 1 THEN
        RAISE EXCEPTION 'failed writes were not rolled back';
    END IF;
END;
$test$;
