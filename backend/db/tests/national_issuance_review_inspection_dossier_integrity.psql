      THEN 'aa600000-0000-4000-8000-000000000192'::uuid
    WHEN 'aa600000-0000-4000-8000-000000000101'
      THEN 'aa600000-0000-4000-8000-000000000202'::uuid
    ELSE 'aa600000-0000-4000-8000-000000000212'::uuid END,
 a.audit_id,'NationalIssuanceReviewIntentCaptured',
 'national_issuance_review_intent',a.target_id,transaction_timestamp(),
