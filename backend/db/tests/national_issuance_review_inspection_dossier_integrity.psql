       AND request_outbox_integrity_valid=true
   ) THEN RAISE EXCEPTION 'S77 failed scalar-type isolation for synthetic request %',v_request_id; END IF;
 END LOOP;

 IF (SELECT count(*) FROM programs.national_issuance_review_integrity_findings
      WHERE finding_code='SOURCE_ENVELOPE_INVALID')<>7
 THEN RAISE EXCEPTION 'S77 scalar-type failures did not map to source-envelope finding'; END IF;

 IF (SELECT count(*) FROM programs.national_issuance_review_integrity_findings)<>11
 THEN RAISE EXCEPTION 'S77 expected eleven isolated integrity findings'; END IF;
END;$s77_scalar_types$;


