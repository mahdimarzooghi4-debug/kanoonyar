DO $s75_semantic_envelope$
DECLARE v_request_id uuid;
BEGIN
 FOREACH v_request_id IN ARRAY ARRAY[
   'aa600000-0000-4000-8000-000000000081'::uuid,
   'aa600000-0000-4000-8000-000000000091'::uuid,
   'aa600000-0000-4000-8000-000000000101'::uuid,
   'aa600000-0000-4000-8000-000000000111'::uuid
 ] LOOP
   IF NOT EXISTS (
     SELECT 1 FROM programs.national_issuance_review_inspection_summary
     WHERE programs.national_issuance_review_inspection_summary.request_id=v_request_id
       AND request_source_integrity_valid=false
       AND request_snapshot_digest_valid=true
       AND request_source_envelope_valid=false
       AND request_center_selection_valid=true
       AND request_authority_flags_clear=true
       AND request_audit_integrity_valid=true
       AND request_outbox_integrity_valid=true
   ) THEN RAISE EXCEPTION 'S75 failed semantic envelope isolation for synthetic request %',v_request_id; END IF;
 END LOOP;
END;$s75_semantic_envelope$;


-- S76 maps component booleans to stable aggregate finding codes.
DO $s76_integrity_findings$
DECLARE finding_count bigint;
BEGIN
 IF NOT EXISTS (
   SELECT 1 FROM pg_class c
   WHERE c.oid='programs.national_issuance_review_integrity_findings'::regclass
     AND c.relkind='v'
     AND 'security_invoker=true'=ANY(COALESCE(c.reloptions,ARRAY[]::text[]))
 ) THEN RAISE EXCEPTION 'S76 findings view is not SECURITY INVOKER'; END IF;

 IF EXISTS (
   SELECT 1 FROM pg_attribute
   WHERE attrelid='programs.national_issuance_review_integrity_findings'::regclass
     AND attnum>0 AND NOT attisdropped
     AND attname=ANY(ARRAY[
       'explicit_center_ids','original_source_snapshot','center_id',
       'technical_note','unverified_requester_subject',
       'unverified_inspector_subject','observed_source_snapshot',
       'stated_review_reason'])
 ) OR (
   SELECT count(*) FROM pg_attribute
   WHERE attrelid='programs.national_issuance_review_integrity_findings'::regclass
     AND attnum>0 AND NOT attisdropped
 )<>5 THEN RAISE EXCEPTION 'S76 findings view exposes private fields or an unstable shape'; END IF;

 IF has_table_privilege('public',
      'programs.national_issuance_review_integrity_findings','SELECT')
 OR has_table_privilege('kanoonyar_s61_inspection_denied_ci',
      'programs.national_issuance_review_integrity_findings','SELECT')
 OR has_table_privilege('kanoonyar_s60_unprivileged_ci',
      'programs.national_issuance_review_integrity_findings','SELECT')
 THEN RAISE EXCEPTION 'S76 findings view granted restricted read access'; END IF;

 SELECT count(*) INTO finding_count
 FROM programs.national_issuance_review_integrity_findings;
 IF finding_count<>9 THEN
   RAISE EXCEPTION 'S76 expected nine isolated findings, observed %',finding_count;
 END IF;

 IF (SELECT count(*) FROM programs.national_issuance_review_integrity_findings
       WHERE finding_code='SOURCE_SNAPSHOT_DIGEST_INVALID')<>1
 OR (SELECT count(*) FROM programs.national_issuance_review_integrity_findings
       WHERE finding_code='SOURCE_ENVELOPE_INVALID')<>5
 OR (SELECT count(*) FROM programs.national_issuance_review_integrity_findings
       WHERE finding_code='CENTER_SELECTION_MISMATCH')<>1
 OR (SELECT count(*) FROM programs.national_issuance_review_integrity_findings
       WHERE finding_code='AUDIT_EVIDENCE_INVALID')<>1
 OR (SELECT count(*) FROM programs.national_issuance_review_integrity_findings
       WHERE finding_code='OUTBOX_EVIDENCE_INVALID')<>1
 OR (SELECT count(*) FROM programs.national_issuance_review_integrity_findings
       WHERE finding_code='AUTHORITY_FLAGS_NOT_CLEAR')<>0
 THEN RAISE EXCEPTION 'S76 finding-code mapping does not match component diagnostics'; END IF;

 IF EXISTS (
   SELECT 1 FROM programs.national_issuance_review_integrity_findings
   WHERE finding_contract_version<>'S76_INTEGRITY_FINDING_V1'
 ) OR EXISTS (
   SELECT 1 FROM programs.national_issuance_review_integrity_findings
   WHERE request_id=ANY(ARRAY[
     'aa600000-0000-4000-8000-000000000001'::uuid,
     'aa600000-0000-4000-8000-000000000011'::uuid,
     'aa600000-0000-4000-8000-000000000021'::uuid])
 ) THEN RAISE EXCEPTION 'S76 emitted an unstable or valid-request finding'; END IF;
END;$s76_integrity_findings$;

-- S77 verifies JSON scalar types independently from textual ->> equality.
-- Each fixture has a matching digest, center selection, audit and outbox;
-- only one source envelope scalar type is wrong in each record.
BEGIN;
WITH fixtures(request_id,program_id,center_ids,program_value,version_value,center_id) AS (
 VALUES
  ('aa600000-0000-4000-8000-000000000121'::uuid,'123',
   ARRAY['s77-center-program-type']::text[],to_jsonb(123),to_jsonb(2),
   's77-center-program-type'),
  ('aa600000-0000-4000-8000-000000000131'::uuid,'s60-original-program',
   ARRAY['s77-center-version-type']::text[],to_jsonb('s60-original-program'::text),
   to_jsonb('2'::text),'s77-center-version-type')
), snapshots AS (
 SELECT request_id,program_id,center_ids,
   jsonb_build_object('formatVersion','S60_SOURCE_SNAPSHOT_V1',
     'programId',program_value,'nationalVersion',version_value,
     'exactPublicationExists',true,
     'centers',jsonb_build_array(jsonb_build_object(
       'centerId',center_id,'registryExists',true,
       'registryActive',true,'exactIssuanceExists',false))) AS snapshot
 FROM fixtures
)
