-- S62: verify the virtual technical dossier is complete, non-authorizing,
-- privacy-minimized, and inaccessible to restricted operational SQL users.
\set ON_ERROR_STOP on

DO $catalog$
DECLARE dossier_count bigint;
BEGIN
 IF NOT EXISTS (
   SELECT 1 FROM pg_class c
   WHERE c.oid='programs.national_issuance_review_inspection_dossier'::regclass
     AND c.relkind='v'
     AND 'security_invoker=true'=ANY(COALESCE(c.reloptions,ARRAY[]::text[]))
 ) THEN RAISE EXCEPTION 'S62 dossier is not a SECURITY INVOKER view'; END IF;

 IF EXISTS (
   SELECT 1 FROM pg_attribute
   WHERE attrelid='programs.national_issuance_review_inspection_dossier'::regclass
     AND attnum>0 AND NOT attisdropped
     AND attname=ANY(ARRAY[
       'technical_note','unverified_inspector_subject',
       'explicit_center_ids','observed_source_snapshot',
       'original_source_snapshot'])
 ) THEN RAISE EXCEPTION 'S62 dossier exposes private source or free-text fields'; END IF;

 IF has_table_privilege('kanoonyar_s61_inspection_denied_ci',
    'programs.national_issuance_review_inspection_dossier','SELECT')
 OR has_table_privilege('kanoonyar_s60_unprivileged_ci',
    'programs.national_issuance_review_inspection_dossier','SELECT')
 THEN RAISE EXCEPTION 'Restricted operational SQL account can read technical dossier'; END IF;

 SELECT count(*) INTO dossier_count
 FROM programs.national_issuance_review_inspection_dossier;
 IF dossier_count<>3 THEN
   RAISE EXCEPTION 'S62 dossier omitted or duplicated inspection notes: %',dossier_count;
 END IF;

 IF EXISTS (
   SELECT 1 FROM programs.national_issuance_review_inspection_dossier
   WHERE NOT original_request_integrity_valid
      OR NOT observation_integrity_valid
      OR NOT audit_and_outbox_integrity_valid
      OR human_review_recorded
      OR issuance_authorized
      OR issuance_executed
 ) THEN RAISE EXCEPTION 'S62 dossier failed integrity or acquired authority'; END IF;

 IF (SELECT count(*) FROM programs.national_issuance_review_inspection_dossier
     WHERE source_changed_since_request)<>2
 OR (SELECT count(*) FROM programs.national_issuance_review_inspection_dossier
     WHERE NOT source_changed_since_request)<>1
 THEN RAISE EXCEPTION 'S62 dossier lost changed/unchanged historical observations'; END IF;

 IF EXISTS (
   SELECT 1 FROM programs.national_issuance_review_inspection_dossier
   WHERE current_source_digest_sha256 !~ '^[a-f0-9]{64}
 -- The first inspection of request 1 predates the later synthetic issuance
 -- for center-05; the later inspection reflects it. Request 2 concerns only
 -- center-04 and remains current. Historical note digests are never rewritten.
 IF (SELECT current_source_matches_observation
     FROM programs.national_issuance_review_inspection_dossier
     WHERE note_id='aa610000-0000-4000-8000-000000000001') IS DISTINCT FROM false
 OR (SELECT current_source_matches_observation
     FROM programs.national_issuance_review_inspection_dossier
     WHERE note_id='aa610000-0000-4000-8000-000000000011') IS DISTINCT FROM true
 OR (SELECT current_source_matches_observation
     FROM programs.national_issuance_review_inspection_dossier
     WHERE note_id='aa610000-0000-4000-8000-000000000021') IS DISTINCT FROM true
 THEN RAISE EXCEPTION 'S68 failed to distinguish latest source drift from historical observations'; END IF;

 IF EXISTS (
   SELECT 1 FROM programs.national_issuance_review_inspection_dossier
   WHERE current_source_matches_observation
     <> (current_source_digest_sha256=observed_digest_sha256)
 ) THEN RAISE EXCEPTION 'S68 current-source match flag disagrees with recomputed digest'; END IF;
END;$catalog$;

\connect - kanoonyar_s61_inspection_denied_ci
DO $deny$
BEGIN
 BEGIN
   PERFORM 1 FROM programs.national_issuance_review_inspection_dossier;
   RAISE EXCEPTION 'Restricted account read the S62 technical dossier';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
END;$deny$;
\connect - postgres

 ) THEN RAISE EXCEPTION 'S68 current source digest is malformed'; END IF;

 -- S69 returns aggregate counts only, and leaves them null if the immutable
 -- observation cannot be safely compared to the current source.
 IF EXISTS (
   SELECT 1 FROM programs.national_issuance_review_inspection_dossier
   WHERE publication_state_changed IS NULL
      OR center_registry_change_count IS NULL
      OR exact_issuance_change_count IS NULL
 ) THEN RAISE EXCEPTION 'S69 drift summary is incomplete for valid observations'; END IF;

 IF EXISTS (
   SELECT 1 FROM programs.national_issuance_review_inspection_dossier
   WHERE publication_state_changed IS DISTINCT FROM false
      OR center_registry_change_count<>0
 ) THEN RAISE EXCEPTION 'S69 reported unexpected publication or registry drift'; END IF;

 -- Only the first note predates the later synthetic exact issuance for
 -- center-05. The later and independent notes are current at their own source.
 IF (SELECT exact_issuance_change_count
     FROM programs.national_issuance_review_inspection_dossier
     WHERE note_id='aa610000-0000-4000-8000-000000000001') IS DISTINCT FROM 1
 OR (SELECT exact_issuance_change_count
     FROM programs.national_issuance_review_inspection_dossier
     WHERE note_id='aa610000-0000-4000-8000-000000000011') IS DISTINCT FROM 0
 OR (SELECT exact_issuance_change_count
     FROM programs.national_issuance_review_inspection_dossier
     WHERE note_id='aa610000-0000-4000-8000-000000000021') IS DISTINCT FROM 0
 THEN RAISE EXCEPTION 'S69 exact-issuance drift counts do not match synthetic history'; END IF;

 -- The first inspection of request 1 predates the later synthetic issuance
 -- for center-05; the later inspection reflects it. Request 2 concerns only
 -- center-04 and remains current. Historical note digests are never rewritten.
 IF (SELECT current_source_matches_observation
     FROM programs.national_issuance_review_inspection_dossier
     WHERE note_id='aa610000-0000-4000-8000-000000000001') IS DISTINCT FROM false
 OR (SELECT current_source_matches_observation
     FROM programs.national_issuance_review_inspection_dossier
     WHERE note_id='aa610000-0000-4000-8000-000000000011') IS DISTINCT FROM true
 OR (SELECT current_source_matches_observation
     FROM programs.national_issuance_review_inspection_dossier
     WHERE note_id='aa610000-0000-4000-8000-000000000021') IS DISTINCT FROM true
 THEN RAISE EXCEPTION 'S68 failed to distinguish latest source drift from historical observations'; END IF;

 IF EXISTS (
   SELECT 1 FROM programs.national_issuance_review_inspection_dossier
   WHERE current_source_matches_observation
     <> (current_source_digest_sha256=observed_digest_sha256)
 ) THEN RAISE EXCEPTION 'S68 current-source match flag disagrees with recomputed digest'; END IF;
END;$catalog$;

\connect - kanoonyar_s61_inspection_denied_ci
DO $deny$
BEGIN
 BEGIN
   PERFORM 1 FROM programs.national_issuance_review_inspection_dossier;
   RAISE EXCEPTION 'Restricted account read the S62 technical dossier';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
END;$deny$;
\connect - postgres
