DO $s77_scalar_types$
DECLARE v_request_id uuid;
BEGIN
 FOREACH v_request_id IN ARRAY ARRAY[
   'aa600000-0000-4000-8000-000000000121'::uuid,
   'aa600000-0000-4000-8000-000000000131'::uuid
 ] LOOP
   IF NOT EXISTS (
     SELECT 1 FROM programs.national_issuance_review_inspection_summary
     WHERE programs.national_issuance_review_inspection_summary.request_id=v_request_id
       AND request_source_integrity_valid=false
       AND request_snapshot_digest_valid=true
