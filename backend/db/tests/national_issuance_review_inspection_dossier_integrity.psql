    WHEN 'aa600000-0000-4000-8000-000000000081'::uuid
      THEN 'aa600000-0000-4000-8000-000000000082'::uuid
    WHEN 'aa600000-0000-4000-8000-000000000091'::uuid
      THEN 'aa600000-0000-4000-8000-000000000092'::uuid
    WHEN 'aa600000-0000-4000-8000-000000000101'::uuid
      THEN 'aa600000-0000-4000-8000-000000000102'::uuid
    ELSE 'aa600000-0000-4000-8000-000000000112'::uuid END,
 transaction_timestamp(),'UNVERIFIED-s75-fixture-actor',NULL,
 'NATIONAL_ISSUANCE_REVIEW_INTENT_CAPTURED',
 'national_issuance_review_intent',i.request_id::text,
 's75-'||i.request_id::text,
